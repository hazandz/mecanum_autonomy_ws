{
  "$defs": {
    "external_package_lock_entry": {
      "additionalProperties": false,
      "properties": {
        "apt_repository_origin": {
          "minLength": 1,
          "type": "string"
        },
        "architecture": {
          "minLength": 1,
          "type": "string"
        },
        "deb_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "debian_package_name": {
          "minLength": 1,
          "type": "string"
        },
        "dependency_closure_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_capture_method": {
          "minLength": 1,
          "type": "string"
        },
        "installed_version": {
          "minLength": 1,
          "type": "string"
        },
        "ros_distribution": {
          "minLength": 1,
          "type": "string"
        },
        "ros_package_name": {
          "enum": [
            "nav2_bringup",
            "nav2_amcl",
            "nav2_map_server",
            "nav2_lifecycle_manager",
            "nav2_planner",
            "nav2_controller",
            "nav2_bt_navigator",
            "nav2_costmap_2d",
            "robot_localization",
            "tf2_ros",
            "robot_state_publisher",
            "sensor_msgs",
            "nav_msgs",
            "geometry_msgs"
          ],
          "type": "string"
        },
        "ubuntu_release": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "ros_distribution",
        "ubuntu_release",
        "ros_package_name",
        "debian_package_name",
        "installed_version",
        "architecture",
        "apt_repository_origin",
        "deb_sha256",
        "dependency_closure_sha256",
        "evidence_capture_method"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "workspace_source_lock_entry": {
      "additionalProperties": false,
      "properties": {
        "owner_package": {
          "minLength": 1,
          "type": "string"
        },
        "repository_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository_relative_path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "status": {
          "description": "Unresolved source selection uses PENDING_IMPLEMENTATION_SOURCE_PIN. A resolved-state token is not introduced by this schema and requires later Owner governance.",
          "type": "string"
        }
      },
      "required": [
        "repository_commit",
        "repository_relative_path",
        "source_file_sha256",
        "owner_package",
        "role",
        "status"
      ],
      "type": "object"
    }
  },
  "$id": "urn:mecanum:wp05:navigation-v1-dependency-lock:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
