<?xml version="1.0"?>
<window>
  <width>1280</width><height>800</height>
  <default_exit_action>CLOSE_GUI</default_exit_action>
  <dialog_on_exit>false</dialog_on_exit>
</window>
<plugin filename="MinimalScene" name="MinimalScene">
  <gz-gui><title>Roadmap B Local Training</title><property type="bool" key="showTitleBar">false</property></gz-gui>
  <engine>ogre2</engine><scene>scene</scene><ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.8 0.8 0.8</background_color><camera_pose>-5 -5 5 0 0.5 0.8</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="GzSceneManager"/>
<plugin filename="InteractiveViewControl" name="InteractiveViewControl"/>
